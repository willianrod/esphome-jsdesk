#!/bin/sh
# Hot-plug USB serial devices into the ESPHome container (CT 109).
# Nodes live in /dev/esphome-usb (bind-mounted into the CT); a symlink exposes them as /dev/<name>.
CTID=109
DIR=/dev/esphome-usb
action=$1; dev=$2
case "$action" in
  add)
    rm -f $DIR/$dev
    set -- $(stat -c "%t %T" /dev/$dev); mknod $DIR/$dev c $((0x$1)) $((0x$2))
    chown 100000:100020 $DIR/$dev; chmod 0660 $DIR/$dev
    pct status $CTID 2>/dev/null | grep -q running && pct exec $CTID -- ln -sfn $DIR/$dev /dev/$dev
    exit 0 ;;
  remove)
    rm -f $DIR/$dev
    pct status $CTID 2>/dev/null | grep -q running && pct exec $CTID -- rm -f /dev/$dev
    exit 0 ;;
esac
