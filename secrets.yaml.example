# Copy to secrets.yaml (it is git-ignored) and fill in your own values.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
# Generate with: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
desk_api_key: "base64-32-byte-key"
desk_ap_password: "fallback-hotspot-password"
# IP the dashboard uses for OTA/logs (DHCP reservation), or desk.local
desk_address: "192.168.1.50"
